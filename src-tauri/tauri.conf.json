{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mini Streaks",
  "mainBinaryName": "mini-streaks",
  "version": "0.2.0",
  "identifier": "com.komma.mini-streaks",
  "build": {
    "beforeDevCommand": "corepack pnpm@11.24.0 dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm@11.24.0 build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mini Streaks",
        "width": 400,
        "height": 600,
        "minWidth": 360,
        "maxWidth": 460,
        "minHeight": 520,
        "maxHeight": 760,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Tiny habit streaks that track themselves",
    "longDescription": "Mini Streaks keeps your daily habits alive. It counts minutes while you use the apps you pick, lets you check off everything else by hand, and nudges you before a streak ends.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
